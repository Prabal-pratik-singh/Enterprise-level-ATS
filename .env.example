# Copy to .env to override. Everything except the API boots without a .env file —
# docker-compose.yml falls back to the defaults shown here. The API needs JWT_SECRET (sign-in).

# ---- infrastructure credentials ----
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_DB=ats
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- backend services (compose sets these per service; listed for running
# ---- a service jar directly against the dockerized infra) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DB_URL=jdbc:postgresql://localhost:5434/ats
DB_USER=ats
DB_PASSWORD=ats
S3_ENDPOINT=http://localhost:9000
# What presigned upload URLs are signed for (the address the uploading client uses)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
# Extra JVM flags for backend containers (e.g. -XX:MaxRAMPercentage=75)
JAVA_OPTS=

# ---- LLM (Phase 4+) ----
# Provider switch: ollama (local, default) | groq | gemini (cloud, need keys)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# Local CPU inference is slow; cloud providers can use the spec's 60s
LLM_READ_TIMEOUT_SECONDS=180
# Get free keys: console.groq.com · aistudio.google.com — put real values in .env (gitignored)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- sign-in (Part 2) ----
# Signs the 15-minute access tokens; the API refuses to start without it (32+ characters).
# Generate one: openssl rand -base64 48
JWT_SECRET=
# The dashboard's demo recruiter, created when the API first starts (an existing account is left alone)
RECRUITER_EMAIL=recruiter@ats.local
RECRUITER_PASSWORD=
