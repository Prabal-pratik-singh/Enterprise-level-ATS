# Copy to .env to override. Everything boots without a .env file —
# docker-compose.yml falls back to the defaults shown here.

# ---- infrastructure credentials ----
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_DB=ats
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- backend services (compose sets these per service; listed for running
# ---- a service jar directly against the dockerized infra) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DB_URL=jdbc:postgresql://localhost:5434/ats
DB_USER=ats
DB_PASSWORD=ats
S3_ENDPOINT=http://localhost:9000
# What presigned upload URLs are signed for (the address the uploading client uses)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
# Extra JVM flags for backend containers (e.g. -XX:MaxRAMPercentage=75)
JAVA_OPTS=
